# EmailJS Configuration for Portfolio Contact Form
# Get these 3 values from your EmailJS Dashboard (https://dashboard.emailjs.com/)

# 1. Email Service ID (from Email Services tab, e.g. service_xxxxxxx)
VITE_EMAILJS_SERVICE_ID=

# 2. Email Template ID (from Email Templates tab, e.g. template_xxxxxxx)
VITE_EMAILJS_TEMPLATE_ID=

# 3. Public Key (from Account > API Keys > Public Key, e.g. user_xxxxxxx / xxxxxxx)
VITE_EMAILJS_PUBLIC_KEY=
